    wsNew.Cells(타이틀행, 1).Font.Size = 20
    wsNew.Cells(타이틀행, 1).Font.Bold = True
    wsNew.Cells(타이틀행, 1).Font.Name = "Microsoft GothicNeo"
    outRow = outRow + 1

    outCol = 1
    wsNew.Cells(헤더행, outCol).Value = "원단명": outCol = outCol + 1
    wsNew.Cells(헤더행, outCol).Value = "항목": outCol = outCol + 1
    For i = 1 To dayCount
        wsNew.Cells(헤더행, outCol + i - 1).Value = dayVals(i) & "일"
