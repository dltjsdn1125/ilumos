    For Each key In Co목록.keys
        j = j + 1
        Co정렬키(j) = key
    Next key
    For i = 1 To UBound(Co정렬키) - 1
        For j = i + 1 To UBound(Co정렬키)
            If Co목록(Co정렬키(i)) > Co목록(Co정렬키(j)) Then
                CoKey = Co정렬키(i): Co정렬키(i) = Co정렬키(j): Co정렬키(j) = CoKey
            End If
        Next j
    Next i

    항목목록 = Split("롤수,Kg", ",")

    Application.ScreenUpdating = False
    Set wbNew = Workbooks.Add
