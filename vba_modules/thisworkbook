    outCol = outCol + dayCount
    wsNew.Cells(헤더행, outCol).Value = "주1평균": wsNew.Cells(헤더행, outCol + 1).Value = "주2평균": wsNew.Cells(헤더행, outCol + 2).Value = "주3평균"
    wsNew.Cells(헤더행, outCol + 3).Value = "주4평균": wsNew.Cells(헤더행, outCol + 4).Value = "주5평균"
    wsNew.Cells(헤더행, outCol + 5).Value = "월합계": wsNew.Cells(헤더행, outCol + 6).Value = "월평균"
    outRow = 4

    Dim Co별시작행() As Long, Co별끝행() As Long, Co별이름() As String, Co개수 As Long
    Dim 항목인덱스 As Long, 일값 As Double
    Co개수 = UBound(Co정렬키)
    ReDim Co별시작행(1 To Co개수): ReDim Co별끝행(1 To Co개수): ReDim Co별이름(1 To Co개수)

    For i = 1 To Co개수
        Co = Co정렬키(i)
        If Co명딕.exists(Co) Then Co표시명 = Co명딕(Co) Else Co표시명 = Co
        Co별이름(i) = Co표시명
        Co별시작행(i) = outRow
        For j = 0 To UBound(항목목록)
            항목 = Trim(항목목록(j))
            항목인덱스 = j
            wsNew.Cells(outRow, 1).Value = Co표시명
            wsNew.Cells(outRow, 2).Value = 항목
            합계 = 0
            For w = 1 To dayCount
                k = Co & "|" & w & "|" & 항목인덱스
                일값 = 0
                If 집계딕.exists(k) Then 일값 = CDbl(집계딕(k))
                wsNew.Cells(outRow, 2 + w).Value = 일값
                합계 = 합계 + 일값
            Next w
            For w = 1 To 5
                주합계 = 0: 주시작 = (w - 1) * 7 + 1: 주끝 = w * 7
                If 주시작 > dayCount Then Exit For
                If 주끝 > dayCount Then 주끝 = dayCount
                For r = 주시작 To 주끝
                    If IsNumeric(wsNew.Cells(outRow, 2 + r).Value) Then 주합계 = 주합계 + CDbl(wsNew.Cells(outRow, 2 + r).Value)
                Next r
                주평균 = IIf(주끝 - 주시작 + 1 > 0, 주합계 / (주끝 - 주시작 + 1), 0)
                wsNew.Cells(outRow, 2 + dayCount + w).Value = Round(주평균, 2)
            Next w
            평균 = IIf(dayCount > 0, 합계 / dayCount, 0)
            wsNew.Cells(outRow, 2 + dayCount + 6).Value = Round(합계, 2)
            wsNew.Cells(outRow, 2 + dayCount + 7).Value = Round(평균, 2)
            outRow = outRow + 1
        Next j
        Co별끝행(i) = outRow - 1
    Next i

    Dim 테이블끝행 As Long, msgRow As Long
    테이블끝행 = outRow - 1
    msgRow = 테이블끝행 + 2
    msg = "※ 본 데이터는 매크로 실행 시점(" & Format(Now, "yyyy-mm-dd hh:nn") & ") 기준으로 가공된 현황입니다. 저장은 사용자가 결정합니다."
    wsNew.Cells(msgRow, 1).Value = msg
    wsNew.Cells(msgRow, 1).Font.Italic = True
    wsNew.Cells(msgRow, 1).Font.Size = 9
    wsNew.Cells(msgRow, 1).Font.Name = "Microsoft GothicNeo"

    Dim tblRng As Range
    Set tblRng = wsNew.Range(wsNew.Cells(타이틀행, 1), wsNew.Cells(테이블끝행, 2 + dayCount + 7))
    tblRng.Font.Name = "Microsoft GothicNeo"
    wsNew.Range(wsNew.Cells(헤더행, 1), wsNew.Cells(헤더행, 2 + dayCount + 7)).Font.Bold = True
    With wsNew.Range(wsNew.Cells(헤더행, 1), wsNew.Cells(테이블끝행, 2 + dayCount + 7)).Borders
        .LineStyle = xlContinuous
        .Weight = xlThin
        .color = RGB(192, 192, 192)
    End With
    wsNew.Rows(헤더행).RowHeight = 30
    wsNew.Range(wsNew.Cells(헤더행, 1), wsNew.Cells(헤더행, 2 + dayCount)).Interior.color = RGB(233, 249, 153)
    wsNew.Range(wsNew.Cells(헤더행, 2 + dayCount + 1), wsNew.Cells(헤더행, 2 + dayCount + 7)).Interior.color = RGB(238, 250, 194)
    wsNew.Range(wsNew.Cells(헤더행 + 1, 2 + dayCount + 1), wsNew.Cells(테이블끝행, 2 + dayCount + 7)).Interior.color = RGB(255, 255, 231)
    wsNew.Range(wsNew.Cells(4, 1), wsNew.Cells(테이블끝행, 1)).Interior.color = RGB(237, 250, 160)
    wsNew.Range(wsNew.Cells(4, 2), wsNew.Cells(테이블끝행, 2)).Interior.color = RGB(248, 253, 215)
    Dim 매크로_DisplayAlerts As Boolean
    매크로_DisplayAlerts = Application.DisplayAlerts
    Application.DisplayAlerts = False
    For i = 1 To Co개수
        If Co별끝행(i) >= Co별시작행(i) Then
            On Error Resume Next
            wsNew.Range(wsNew.Cells(Co별시작행(i), 1), wsNew.Cells(Co별끝행(i), 1)).Merge
            wsNew.Range(wsNew.Cells(Co별시작행(i), 1), wsNew.Cells(Co별끝행(i), 1)).HorizontalAlignment = xlCenter
            wsNew.Range(wsNew.Cells(Co별시작행(i), 1), wsNew.Cells(Co별끝행(i), 1)).VerticalAlignment = xlCenter
            On Error GoTo 0
        End If
    Next i
    Application.DisplayAlerts = 매크로_DisplayAlerts

    For i = 1 To Co개수
        If Co별끝행(i) >= Co별시작행(i) Then
            With wsNew.Range(wsNew.Cells(Co별시작행(i), 1), wsNew.Cells(Co별시작행(i), 2 + dayCount + 7)).Borders(xlEdgeTop)
                .LineStyle = xlContinuous
                .Weight = xlMedium
                .color = RGB(128, 128, 128)
            End With
            With wsNew.Range(wsNew.Cells(Co별끝행(i), 1), wsNew.Cells(Co별끝행(i), 2 + dayCount + 7)).Borders(xlEdgeBottom)
                .LineStyle = xlContinuous
                .Weight = xlMedium
                .color = RGB(128, 128, 128)
            End With
        End If
    Next i

    wsNew.Cells.Columns.AutoFit
    wsNew.Columns("A:A").ColumnWidth = 20

    Const chH As Double = 283.5
    Const chW As Double = 680.4
    Const 차트간격 As Double = 28.35
    Dim chLeft As Double, chTop As Double
    chTop = wsNew.Cells(msgRow + 2, 1).top
    chLeft = wsNew.Cells(msgRow + 2, 1).left
    Dim ch As ChartObject, h As Long, s As Long, 색상표3(1 To 6) As Long
    색상표3(1) = RGB(240, 125, 50)
    색상표3(2) = RGB(252, 194, 0)
    색상표3(3) = RGB(119, 186, 70)
    색상표3(4) = RGB(172, 70, 48)
    색상표3(5) = RGB(155, 130, 40)
    색상표3(6) = RGB(60, 120, 50)
    For h = 1 To Co개수
        If Co별끝행(h) < Co별시작행(h) Then GoTo NextChart원지
        On Error Resume Next
        Set ch = wsNew.ChartObjects.Add(chLeft, chTop, chW, chH)
        ch.Chart.SetSourceData Source:=wsNew.Range(wsNew.Cells(Co별시작행(h), 1), wsNew.Cells(Co별끝행(h), 2 + dayCount)), PlotBy:=xlRows
        ch.Chart.ChartType = xlColumnStacked
        On Error Resume Next
        ch.Chart.ChartStyle = 201
        On Error GoTo 0
        ch.Chart.SetElement 302
        ch.Chart.HasTitle = True
        ch.Chart.ChartTitle.Text = Co별이름(h) & " 일별 현황"
        ch.Chart.ChartTitle.Font.Name = "Microsoft GothicNeo"
        ch.Chart.Axes(xlCategory).HasTitle = False
        ch.Chart.Axes(xlValue).HasTitle = False
        ch.Chart.Axes(xlCategory).TickLabels.Font.Name = "Microsoft GothicNeo"
        ch.Chart.Axes(xlValue).TickLabels.Font.Name = "Microsoft GothicNeo"
        ch.Chart.Legend.position = xlLegendPositionBottom
        ch.Chart.Legend.Font.Name = "Microsoft GothicNeo"
        ch.Chart.ChartGroups(1).Overlap = 100
        ch.Chart.ChartGroups(1).GapWidth = 50
        For s = 1 To ch.Chart.SeriesCollection.Count
            ch.Chart.SeriesCollection(s).Format.Fill.ForeColor.RGB = 색상표3(((s - 1) Mod 6) + 1)
        Next s
        If (h Mod 2) = 1 Then
            chLeft = chLeft + chW + 차트간격
        Else
            chLeft = wsNew.Cells(msgRow + 2, 1).left
            chTop = chTop + chH + 차트간격
        End If
        On Error GoTo 0
NextChart원지:
    Next h

    On Error Resume Next
    wsNew.Activate
    wsNew.Range("Q4").Select
    ActiveWindow.FreezePanes = True
    On Error GoTo 0

    Application.ScreenUpdating = True
    MsgBox "원단 현재월 생산현황을 새 워크북으로 생성했습니다." & vbCrLf & _
           "저장 여부는 사용자가 결정하세요.", vbInformation, "원단 현재월 생산현황"
