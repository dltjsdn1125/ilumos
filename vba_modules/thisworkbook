'===== 기존 시트만 이름 변경/삭제 불가 (추가된 시트는 자유) =====
' 숨김시트 __WB_SheetNames: A열=원래 시트명, B열=CodeName(시트 고유식별), C1=복원 실행 중이면 1
' Open 시점에 있던 시트만 보호. 그 이후 추가한 시트는 이름 변경/삭제 가능.

Private Sub 시트명_원래이름_저장()
    Dim wsHide As Worksheet
    Dim wsNew As Worksheet
    Dim i As Long, n As Long
    On Error Resume Next
    Set wsHide = ThisWorkbook.Sheets("__WB_SheetNames")
    If wsHide Is Nothing Then
        Set wsNew = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        wsNew.Name = "__WB_SheetNames"
        If Err.Number <> 0 Then
            Set wsHide = ThisWorkbook.Sheets("__WB_SheetNames")
            Application.DisplayAlerts = False
            wsNew.Delete
            Application.DisplayAlerts = True
        Else
            Set wsHide = wsNew
        End If
        If Not wsHide Is Nothing Then wsHide.Visible = xlSheetVeryHidden
    End If
    On Error GoTo 0
    If wsHide Is Nothing Then Exit Sub
    On Error Resume Next
    wsHide.Unprotect "0205"
    On Error GoTo 0
    n = 0
    For i = 1 To ThisWorkbook.Sheets.Count
        n = n + 1
        wsHide.Cells(n, 1).Value = ThisWorkbook.Sheets(i).Name
        wsHide.Cells(n, 2).Value = ThisWorkbook.Sheets(i).codeName
    Next i
    wsHide.Cells(1, 3).Value = 0
End Sub

Private Sub 시트명_원래이름_복원()
    Dim wsHide As Worksheet
    Dim i As Long, r As Long
    Dim codeName As String, vName As String
    Dim lastRow As Long
    On Error Resume Next
    Set wsHide = ThisWorkbook.Sheets("__WB_SheetNames")
    On Error GoTo 0
    If wsHide Is Nothing Then Exit Sub
    On Error Resume Next
    wsHide.Unprotect "0205"
    On Error GoTo 0
    wsHide.Cells(1, 3).Value = 1
    lastRow = wsHide.Cells(wsHide.Rows.Count, 2).End(xlUp).Row
    If lastRow < 1 Then GoTo Done
    For i = 1 To ThisWorkbook.Sheets.Count
        codeName = ThisWorkbook.Sheets(i).codeName
        For r = 1 To lastRow
            If Trim(CStr(wsHide.Cells(r, 2).Value)) = codeName Then
                vName = Trim(CStr(wsHide.Cells(r, 1).Value))
                If Len(vName) > 0 And ThisWorkbook.Sheets(i).Name <> vName Then
                    ThisWorkbook.Sheets(i).Name = vName
                End If
                Exit For
            End If
        Next r
    Next i
Done:
    wsHide.Cells(1, 3).Value = 0
End Sub

Private Sub Workbook_SheetBeforeDelete(ByVal Sh As Object)
    Dim wsHide As Worksheet
    Dim r As Long, lastRow As Long
    Dim codeName As String
    On Error Resume Next
    Set wsHide = ThisWorkbook.Sheets("__WB_SheetNames")
    On Error GoTo 0
    If wsHide Is Nothing Then Exit Sub
    codeName = Sh.codeName
    lastRow = wsHide.Cells(wsHide.Rows.Count, 2).End(xlUp).Row
    For r = 1 To lastRow
        If Trim(CStr(wsHide.Cells(r, 2).Value)) = codeName Then
            MsgBox "기존 시트가 삭제됩니다. 삭제를 막으려면 통합문서 보호(구조 보호)를 사용하세요.", vbExclamation
            Exit Sub
        End If
    Next r
End Sub

Private Sub Workbook_Open()
    Dim origAlerts As Boolean, origScreen As Boolean
    Dim ws As Worksheet
    origAlerts = Application.DisplayAlerts
    origScreen = Application.ScreenUpdating
    Application.DisplayAlerts = False
    Application.ScreenUpdating = False

    ' 열기 암호 제거 (다음 열 때 암호 입력 불필요)
    On Error Resume Next
    If ThisWorkbook.Password <> "" Then
        ThisWorkbook.Password = ""
        ThisWorkbook.Save
    End If
    On Error GoTo 0

    ' 통합문서 구조·시트 보호 자동 해제 (암호 0205, 비번 입력창 없음)
    On Error Resume Next
    If ThisWorkbook.ProtectStructure Then ThisWorkbook.Unprotect "0205"
    For Each ws In ThisWorkbook.Worksheets
        If ws.ProtectContents Then ws.Unprotect "0205"
    Next ws
    On Error GoTo 0

    Call 시트명_원래이름_저장
    On Error Resume Next
    If Not ThisWorkbook.Worksheets("생산일보") Is Nothing Then
        Application.Run "일일생산일보_시트보호_적용"
    End If
    Application.Run "시트_지정행_잠금적용"
    On Error GoTo 0

    ' 모든 시트: 지정된 셀잠금(Locked) 영역 자동 적용
    On Error Resume Next
    For Each ws In ThisWorkbook.Worksheets
        If Not ws.ProtectContents Then
            ws.Protect Password:="0205", DrawingObjects:=True, Contents:=True, Scenarios:=True, UserInterfaceOnly:=True
        End If
    Next ws
    On Error GoTo 0

    ' 통합문서 구조 보호 자동 재적용
    On Error Resume Next
    If Not ThisWorkbook.ProtectStructure Then
        ThisWorkbook.Protect Password:="0205", Structure:=True, Windows:=False
    End If
    On Error GoTo 0

    Application.ScreenUpdating = origScreen
    Application.DisplayAlerts = origAlerts
End Sub

' ※ 원단관리: 유효성재적용+헤더보정 | Raw data: 원단_목록_RawData_갱신
Private Sub Workbook_SheetActivate(ByVal Sh As Object)
    Dim wsHide As Worksheet
    On Error Resume Next
    Set wsHide = ThisWorkbook.Sheets("__WB_SheetNames")
    On Error GoTo 0
    If wsHide Is Nothing Then
    Else
        If wsHide.Cells(1, 3).Value = 1 Then Exit Sub
        Call 시트명_원래이름_복원
    End If

    ' 시트 선택 시 자동 잠금 적용 (지정된 셀에 대해 Locked + Protect 0205 통일)
    On Error Resume Next
    Application.Run "시트_지정행_잠금적용"
    On Error GoTo 0

    If Sh.Name = "생산일보" Then
        On Error Resume Next
        Application.Run "일일생산일보_시트보호_적용"
        Application.Run "생산일보_제품유효성_적용"
        On Error GoTo 0
    ElseIf Sh.Name = "원단관리" Then
        On Error Resume Next
        Application.Run "원단관리_AB열_유효성_적용"
        Application.Run "원단_셀보호_적용_무음", Sh
        On Error GoTo 0
    ElseIf Sh.Name = "Stock" Then
        On Error Resume Next
        Application.Run "Stock_시트_갱신"
        On Error GoTo 0
    ElseIf Sh.Name = "부자재관리" Then
        On Error Resume Next
        Application.Run "셀보호_적용_무음", Sh
        On Error GoTo 0
    ElseIf UCase(Trim(Sh.Name)) = "RAW DATA" Then
        On Error Resume Next
        Call RawData_D3_제품표준사양서_동기화
        Application.Run "원단_목록_RawData_갱신"
        On Error GoTo 0
    End If
End Sub

